# =============================================================================
# JIMAS BACKEND - ENVIRONMENT VARIABLES
# Copy this file to ".env" for local development and fill in real values.
# On Render, set these under: Service -> Environment -> Add Environment Variable.
# NEVER commit your real .env file to GitHub.
# =============================================================================

# Full PostgreSQL connection string (REQUIRED).
# Render Postgres -> Info -> "External Database URL".
DATABASE_URL=postgresql://jimas_db_ldts_user:mngwWQoTAZtzVqQax0jJHtfSUscUSGkm@dpg-d5fc1qn5r7bs73ansc5g-a.frankfurt-postgres.render.com/jimas_db_ldts

# Secret used to sign login tokens (REQUIRED in production).
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=d5df032ce812c99ec12de6253e09c6001fe498632b3533581a25690726f0324fe0b994898f4ca83f54142d3ecc554c95

# Comma-separated list of frontend URLs allowed to call this API.
# Leave blank to allow all origins (fine for testing, tighten for production).
# Example: https://jimas-frontend.onrender.com,https://jimas.com
ALLOWED_ORIGINS=https://jimas-inventory-pos.vercel.app/

# Port (Render sets this automatically; only needed for local runs).
PORT=3000
